@page
@model ClinicManagement.Web.Pages.Patient.ViewDoctorsModel
@{
    ViewData["Title"] = "View Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-md me-2"></i>View Doctors</h2>
    <a href="/Patient/PatientHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

<!-- Department Selection -->
<div class="card shadow mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row align-items-end">
                <div class="col-md-8">
                    <label class="form-label">Select Department</label>
                    <select name="deptName" class="form-select">
                        <option value="">All Departments</option>
                        @if (Model.Departments != null)
                        {
                            @foreach (var dept in Model.Departments)
                            {
                                <option value="@dept.DeptName" selected="@(Model.SelectedDept == dept.DeptName)">
                                    @dept.DeptName
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i>Search
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Doctors List -->
@if (Model.Doctors != null && Model.Doctors.Any())
{
    <div class="row">
        @foreach (var doc in Model.Doctors)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-user-md fa-3x text-primary mb-2"></i>
                        <h5>@doc.Name</h5>
                        <p class="text-muted">@doc.Department</p>
                        <a href="/Patient/DoctorProfile?doctorId=@doc.DoctorId" class="btn btn-outline-primary btn-sm">
                            View Profile
                        </a>
                        <a href="/Patient/AppointmentTaker?doctorId=@doc.DoctorId" class="btn btn-primary btn-sm ms-1">
                            Book Appointment
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(Model.SelectedDept))
{
    <div class="alert alert-info">No doctors found for the selected department.</div>
}
