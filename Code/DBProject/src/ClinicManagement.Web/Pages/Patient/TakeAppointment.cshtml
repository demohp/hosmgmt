@page
@model ClinicManagement.Web.Pages.Patient.TakeAppointmentModel
@{
    ViewData["Title"] = "Take Appointment";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-calendar-plus me-2"></i>Take Appointment</h2>
    <a href="/Patient/PatientHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <p class="lead">Select a department to find available doctors and book an appointment.</p>
        <a href="/Patient/ViewDoctors" class="btn btn-primary">
            <i class="fas fa-search me-1"></i>Browse Doctors by Department
        </a>
    </div>
</div>

<!-- Departments Quick Access -->
@if (Model.Departments != null && Model.Departments.Any())
{
    <div class="row">
        @foreach (var dept in Model.Departments)
        {
            <div class="col-md-4 mb-3">
                <a href="/Patient/ViewDoctors?deptName=@Uri.EscapeDataString(dept.DeptName)"
                   class="card text-decoration-none shadow h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-hospital fa-2x text-primary mb-2"></i>
                        <h6>@dept.DeptName</h6>
                        @if (!string.IsNullOrEmpty(dept.Description))
                        {
                            <small class="text-muted">@dept.Description</small>
                        }
                    </div>
                </a>
            </div>
        }
    </div>
}
