@page
@model ClinicManagement.Web.Pages.Patient.TreatmentHistoryModel
@{
    ViewData["Title"] = "Treatment History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-history me-2"></i>Treatment History</h2>
    <a href="/Patient/PatientHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.TreatmentHistory != null && Model.TreatmentHistory.Any())
        {
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Appointment ID</th>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Disease</th>
                        <th>Progress</th>
                        <th>Prescription</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.TreatmentHistory)
                    {
                        <tr>
                            <td>@item.AppointId</td>
                            <td>@item.DoctorName</td>
                            <td>@item.Date?.ToString("MM/dd/yyyy")</td>
                            <td>@item.Disease</td>
                            <td>@item.Progress</td>
                            <td>@item.Prescription</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No treatment history found.</div>
        }
    </div>
</div>
