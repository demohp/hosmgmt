@page
@model ClinicManagement.Web.Pages.Patient.PatientFeedbackModel
@{
    ViewData["Title"] = "Patient Feedback";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-star me-2"></i>Patient Feedback</h2>
    <a href="/Patient/PatientHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div class="card shadow">
    <div class="card-body">
        @if (Model.PendingFeedback != null)
        {
            <div class="alert alert-warning mb-4">
                <h5><i class="fas fa-exclamation-circle me-2"></i>Pending Feedback</h5>
                <p><strong>Doctor:</strong> @Model.PendingFeedback.DoctorName</p>
                <p><strong>Appointment Time:</strong> @Model.PendingFeedback.Timings</p>
            </div>
            <form method="post">
                <input type="hidden" name="appointmentId" value="@Model.PendingFeedback.AppointmentId" />
                <p>Please rate your experience with Dr. @Model.PendingFeedback.DoctorName:</p>
                <div class="mb-3">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rating" value="5" id="r5" />
                        <label class="form-check-label" for="r5">⭐⭐⭐⭐⭐ Excellent</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rating" value="4" id="r4" />
                        <label class="form-check-label" for="r4">⭐⭐⭐⭐ Good</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="rating" value="3" id="r3" />
                        <label class="form-check-label" for="r3">⭐⭐⭐ Average</label>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-paper-plane me-1"></i>Submit Feedback
                </button>
            </form>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No pending feedback at this time.
            </div>
        }
    </div>
</div>
