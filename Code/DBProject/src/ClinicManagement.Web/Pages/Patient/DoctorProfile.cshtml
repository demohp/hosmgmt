@page
@model ClinicManagement.Web.Pages.Patient.DoctorProfileModel
@{
    ViewData["Title"] = "Doctor Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-md me-2"></i>Doctor Profile</h2>
    <a href="/Patient/ViewDoctors" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (Model.DoctorProfile != null)
{
    <div class="card shadow">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 text-center">
                    <i class="fas fa-user-md fa-5x text-primary mb-3"></i>
                    <h4>@Model.DoctorProfile.Name</h4>
                    <p class="text-muted">@Model.DoctorProfile.Department</p>
                </div>
                <div class="col-md-9">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <strong><i class="fas fa-phone me-1"></i>Phone:</strong> @Model.DoctorProfile.Phone
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong><i class="fas fa-venus-mars me-1"></i>Gender:</strong> @Model.DoctorProfile.Gender
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong><i class="fas fa-birthday-cake me-1"></i>Age:</strong> @Model.DoctorProfile.Age
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong><i class="fas fa-dollar-sign me-1"></i>Charges/Visit:</strong> @Model.DoctorProfile.ChargesPerVisit.ToString("C")
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong><i class="fas fa-star me-1"></i>Repute Index:</strong> @Model.DoctorProfile.ReputeIndex.ToString("F1")
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong><i class="fas fa-users me-1"></i>Patients Treated:</strong> @Model.DoctorProfile.PatientsTreated
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong><i class="fas fa-graduation-cap me-1"></i>Qualification:</strong> @Model.DoctorProfile.Qualification
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong><i class="fas fa-stethoscope me-1"></i>Specialization:</strong> @Model.DoctorProfile.Specialization
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong><i class="fas fa-briefcase me-1"></i>Experience:</strong> @Model.DoctorProfile.WorkExperience years
                        </div>
                    </div>
                    <div class="mt-3">
                        <a href="/Patient/AppointmentTaker?doctorId=@Model.DoctorProfile.DoctorId" class="btn btn-primary">
                            <i class="fas fa-calendar-plus me-1"></i>Book Appointment
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Doctor profile not found.</div>
}
