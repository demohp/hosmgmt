@page
@model ClinicManagement.Web.Pages.Patient.CurrentAppointmentModel
@{
    ViewData["Title"] = "Current Appointment";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-calendar-day me-2"></i>Current Appointment</h2>
    <a href="/Patient/PatientHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.CurrentAppointment != null)
        {
            <div class="alert alert-success">
                <h5><i class="fas fa-check-circle me-2"></i>You have an appointment today!</h5>
                <p><strong>Doctor:</strong> @Model.CurrentAppointment.DoctorName</p>
                <p><strong>Time:</strong> @Model.CurrentAppointment.Timings</p>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No current appointment for today.
                <a href="/Patient/TakeAppointment" class="btn btn-primary btn-sm ms-2">Book Appointment</a>
            </div>
        }
    </div>
</div>
