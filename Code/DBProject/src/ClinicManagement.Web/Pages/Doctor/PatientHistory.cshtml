@page
@model ClinicManagement.Web.Pages.Doctor.PatientHistoryModel
@{
    ViewData["Title"] = "Patient History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-history me-2"></i>Patient History</h2>
    <a href="/Doctor/DoctorHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.PatientHistory != null && Model.PatientHistory.Any())
        {
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Disease</th>
                        <th>Progress</th>
                        <th>Prescription</th>
                        <th>Bill Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PatientHistory)
                    {
                        <tr>
                            <td>@item.AppointId</td>
                            <td>@item.PatientName</td>
                            <td>@item.Date?.ToString("MM/dd/yyyy")</td>
                            <td>@item.Disease</td>
                            <td>@item.Progress</td>
                            <td>@item.Prescription</td>
                            <td>
                                <span class="badge @(item.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                                    @item.BillStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No patient history found.</div>
        }
    </div>
</div>
