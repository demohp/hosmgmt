@page
@model ClinicManagement.Web.Pages.Doctor.HistoryUpdateModel
@{
    ViewData["Title"] = "Update Patient History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-edit me-2"></i>Update Patient History</h2>
    <a href="/Doctor/DoctorHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<!-- Today's Appointments -->
<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-calendar-day me-2"></i>Today's Appointments</h5>
    </div>
    <div class="card-body">
        @if (Model.TodaysAppointments != null && Model.TodaysAppointments.Any())
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Time</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.TodaysAppointments)
                    {
                        <tr>
                            <td>@appt.AppointId</td>
                            <td>@appt.PatientName</td>
                            <td>@appt.Date?.ToString("HH:mm")</td>
                            <td>
                                <button class="btn btn-primary btn-sm" data-bs-toggle="collapse"
                                        data-bs-target="#update_@appt.AppointId">
                                    <i class="fas fa-edit me-1"></i>Update
                                </button>
                            </td>
                        </tr>
                        <tr class="collapse" id="update_@appt.AppointId">
                            <td colspan="4">
                                <form method="post" class="p-3 bg-light rounded">
                                    <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                    <div class="mb-2">
                                        <label class="form-label">Disease</label>
                                        <input type="text" name="disease" class="form-control" value="@appt.Disease" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Progress</label>
                                        <input type="text" name="progress" class="form-control" value="@appt.Progress" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Prescription</label>
                                        <input type="text" name="prescription" class="form-control" value="@appt.Prescription" />
                                    </div>
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="fas fa-save me-1"></i>Save
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No appointments for today.</div>
        }
    </div>
</div>
