@page
@model ClinicManagement.Web.Pages.Doctor.PreviousHistoryModel
@{
    ViewData["Title"] = "Previous History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-archive me-2"></i>Previous Patient History</h2>
    <a href="/Doctor/DoctorHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.History != null && Model.History.Any())
        {
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Disease</th>
                        <th>Progress</th>
                        <th>Prescription</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.History)
                    {
                        <tr>
                            <td>@item.AppointId</td>
                            <td>@item.PatientName</td>
                            <td>@item.Date?.ToString("MM/dd/yyyy")</td>
                            <td>@item.Disease</td>
                            <td>@item.Progress</td>
                            <td>@item.Prescription</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No previous history found.</div>
        }
    </div>
</div>
