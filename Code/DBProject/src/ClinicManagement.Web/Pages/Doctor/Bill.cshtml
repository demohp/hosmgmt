@page
@model ClinicManagement.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Billing";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-file-invoice-dollar me-2"></i>Billing</h2>
    <a href="/Doctor/DoctorHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.Bills != null && Model.Bills.Any())
        {
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in Model.Bills)
                    {
                        <tr>
                            <td>@bill.AppointId</td>
                            <td>@bill.PatientName</td>
                            <td>@bill.Date?.ToString("MM/dd/yyyy")</td>
                            <td>@bill.BillAmount?.ToString("C")</td>
                            <td>
                                <span class="badge @(bill.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                                    @bill.BillStatus
                                </span>
                            </td>
                            <td>
                                @if (bill.BillStatus != "Paid")
                                {
                                    <form method="post" asp-page-handler="MarkPaid" style="display:inline">
                                        <input type="hidden" name="appointmentId" value="@bill.AppointId" />
                                        <button type="submit" class="btn btn-success btn-sm">
                                            <i class="fas fa-check me-1"></i>Mark Paid
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="MarkUnpaid" style="display:inline">
                                        <input type="hidden" name="appointmentId" value="@bill.AppointId" />
                                        <button type="submit" class="btn btn-warning btn-sm">
                                            <i class="fas fa-undo me-1"></i>Mark Unpaid
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No billing records found.</div>
        }
    </div>
</div>
