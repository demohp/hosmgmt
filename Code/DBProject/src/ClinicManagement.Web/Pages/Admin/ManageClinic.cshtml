@page
@model ClinicManagement.Web.Pages.Admin.ManageClinicModel
@{
    ViewData["Title"] = "Manage Clinic";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-hospital me-2"></i>Manage Clinic</h2>
    <a href="/Admin/AdminHome" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>

<!-- Search Doctors -->
<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-user-md me-2"></i>Doctors</h5>
    </div>
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="doctorSearch" value="@Model.DoctorSearch" class="form-control" placeholder="Search doctors..." />
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Doctors != null)
                {
                    @foreach (var doc in Model.Doctors)
                    {
                        <tr>
                            <td>@doc.DoctorId</td>
                            <td>@doc.Name</td>
                            <td>@doc.Department</td>
                            <td>
                                <form method="post" asp-page-handler="DeleteDoctor" style="display:inline">
                                    <input type="hidden" name="doctorId" value="@doc.DoctorId" />
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to remove this doctor?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Search Staff -->
<div class="card shadow mb-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-users me-2"></i>Staff</h5>
    </div>
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="staffSearch" value="@Model.StaffSearch" class="form-control" placeholder="Search staff..." />
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Designation</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Staff != null)
                {
                    @foreach (var s in Model.Staff)
                    {
                        <tr>
                            <td>@s.StaffId</td>
                            <td>@s.Name</td>
                            <td>@s.Designation</td>
                            <td>
                                <form method="post" asp-page-handler="DeleteStaff" style="display:inline">
                                    <input type="hidden" name="staffId" value="@s.StaffId" />
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to remove this staff member?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
