@page
@model ClinicManagement.Web.Pages.Admin.AdminHomeModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>
    <a href="/SignUp" class="btn btn-outline-danger btn-sm">
        <i class="fas fa-sign-out-alt me-1"></i>Logout
    </a>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body text-center">
                <h5 class="card-title"><i class="fas fa-user-md me-2"></i>Total Doctors</h5>
                <h2 class="display-6">@Model.HomeData?.TotalDoctors</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body text-center">
                <h5 class="card-title"><i class="fas fa-users me-2"></i>Total Patients</h5>
                <h2 class="display-6">@Model.HomeData?.TotalPatients</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-white shadow">
            <div class="card-body text-center">
                <h5 class="card-title"><i class="fas fa-dollar-sign me-2"></i>Total Income</h5>
                <h2 class="display-6">@Model.HomeData?.TotalIncome.ToString("C")</h2>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="fas fa-tools me-2"></i>Quick Actions</h5>
            </div>
            <div class="card-body">
                <a href="/Admin/DoctorRegistrationForm" class="btn btn-primary me-2">
                    <i class="fas fa-user-plus me-1"></i>Add Doctor
                </a>
                <a href="/Admin/AddStaff" class="btn btn-success me-2">
                    <i class="fas fa-user-plus me-1"></i>Add Staff
                </a>
                <a href="/Admin/ManageClinic" class="btn btn-info me-2">
                    <i class="fas fa-hospital me-1"></i>Manage Clinic
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Departments Table -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-building me-2"></i>Departments</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>Department</th>
                            <th>Doctors</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HomeData?.Departments != null)
                        {
                            @foreach (var dept in Model.HomeData.Departments)
                            {
                                <tr>
                                    <td>@dept.DeptName</td>
                                    <td>@dept.DoctorCount</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Appointments -->
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="fas fa-calendar-check me-2"></i>Recent Appointments</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Patient</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HomeData?.Appointments != null)
                        {
                            @foreach (var appt in Model.HomeData.Appointments.Take(5))
                            {
                                <tr>
                                    <td>@appt.DoctorName</td>
                                    <td>@appt.PatientName</td>
                                    <td>@appt.Date?.ToString("MM/dd/yyyy")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
